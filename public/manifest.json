{
  "manifest_version": 3,
  "version": "0.7.6",
  "name": "metldr: AI browser assistant",
  "description": "Read pages, ask questions and automate browser tasks with your AI provider, local models or installed agents.",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self';",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' blob:; object-src 'self'; connect-src 'self';"
  },
  "sandbox": {
    "pages": [
      "sandbox.html",
      "answer-sandbox.html"
    ]
  },
  "action": {
    "default_title": "Open metldr"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "64": "icon-64.png",
    "128": "icon-128.png"
  },
  "side_panel": {
    "default_path": "chat.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "offscreen",
    "nativeMessaging",
    "debugger",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pageWorld.js",
        "assets/logo/metldr-mark-small.svg"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "148",
  "commands": {
    "stop-all-runs": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Stop all runs"
    },
    "open-browser-agent": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Open metldr"
    }
  }
}
