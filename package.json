{
  "name": "metldr",
  "private": true,
  "version": "0.7.6",
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:server": "vite",
    "predev": "npm run build:rust",
    "build": "npm run build:main && npm run build:content",
    "build:rust": "node scripts/build-rust.mjs",
    "build:fast": "cross-env METLDR_PROFILE=fast npm run build",
    "prebuild:main": "npm run build:rust && npm run build:chat",
    "build:main": "vite build",
    "build:content": "cross-env BUILD_TARGET=content vite build && cross-env BUILD_TARGET=gmail vite build",
    "preview": "vite preview",
    "build:chat": "node scripts/build-chat.mjs",
    "check:chat": "npm --prefix extension/chat-ui run check",
    "type-check": "tsc --noEmit",
    "install:chat": "npm ci --prefix extension/chat-ui"
  },
  "dependencies": {
    "@inboxsdk/core": "^2.2.11",
    "@mozilla/readability": "^0.6.0",
    "gsap": "^3.13.0",
    "marked": "^17.0.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.32",
    "cross-env": "^10.1.0",
    "esbuild": "0.25.12",
    "typescript": "^5.9.3",
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
